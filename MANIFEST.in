# Python sdist only — keep TypeScript, Node tests, and build outputs out of PyPI.
graft src/mcp_secure_remote
graft tests
include LICENSE
include README.md
include pyproject.toml
include MANIFEST.in
global-exclude *.ts
global-exclude *.tsx
global-exclude *.js
global-exclude *.js.map
global-exclude *.d.ts
global-exclude *.pyc
global-exclude *.pyo
global-exclude __pycache__
recursive-exclude * __pycache__
prune src/lib
prune test
prune dist
prune dist-py
prune node_modules
prune .github
prune scripts
